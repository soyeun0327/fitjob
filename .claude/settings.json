    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" || exit 0; input=$(cat); case \"$input\" in *.md\\\"*) printf \"%s\" \"$input\" | wsl -e python3 scripts/check_doc_links.py --hook ;; esac",
            "timeout": 60,
            "statusMessage": "문서 링크 검사"
          }
        ]
      }
    ]
